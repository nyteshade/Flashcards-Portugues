<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App is not sandboxed: model files live in ~/.cache/huggingface, the
         user picks arbitrary deck file locations via Save panels, and MLX's
         Metal pipeline expects free filesystem access. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- MLX needs JIT + dynamically-loaded shaders. Without these,
         notarization succeeds but the app crashes on first GPU op
         with a "default metallib" / mmap error. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Translation HTTP fallback + HuggingFace model fetches. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
